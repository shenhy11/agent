# ============================================================
# ChronoTech AI Lab — 环境变量配置模板
# 复制为 .env 并填入真实值，禁止将 .env 提交至 Git
# ============================================================

# ===== 数据库 =====
DB_HOST=postgres
DB_PORT=5432
DB_NAME=agent_db
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== JWT 签名密钥（建议 openssl rand -hex 32 生成）=====
JWT_SECRET=your_256bit_hex_secret_here_change_immediately

# ===== 通义千问 DashScope API Key =====
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Spring 运行配置 =====
SPRING_PROFILES_ACTIVE=prod

# ===== 可选：阿里云 ECS 绑定 IP（给 Nginx / 防火墙用）=====
# SERVER_IP=your.aliyun.ecs.public.ip
