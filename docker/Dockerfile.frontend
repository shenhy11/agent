# ===== Stage 1: Build Stage =====
FROM node:20-alpine AS builder

WORKDIR /app

# 先复制 package.json，利用缓存
COPY agent-next/package*.json ./
RUN npm ci --only=production=false --prefer-offline 2>/dev/null || npm ci

# 复制源码并构建
COPY agent-next/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ===== Stage 2: Run Stage =====
FROM nginx:alpine

LABEL maintainer="ChronoTech Team <dev@chronotech.ai>"

# 复制 Next.js 静态导出产物
COPY --from=builder /app/.next/static /usr/share/nginx/html/_next/static
COPY --from=builder /app/public /usr/share/nginx/html/public

# Nginx 配置
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
