# ===== 纯静态前端 — 基于 agent-web/ HTML 文件 =====
FROM nginx:alpine

LABEL maintainer="ChronoTech Team <dev@chronotech.ai>"

# 复制纯 HTML/CSS/JS 静态文件
COPY agent-web/ /usr/share/nginx/html/

# Nginx 配置（反向代理 + SSE 支持）
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
