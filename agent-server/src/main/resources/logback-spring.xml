<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="agent-server"/>

    <!-- ===== JSON 格式输出（生产环境日志采集标准格式） ===== -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>{"ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS}","level":"%level","app":"${appName}","thread":"%thread","logger":"%logger{36}","msg":"%replace(%msg){'\"', '\\"'}","ex":"%ex{short}"}</pattern>
        </encoder>
    </appender>

    <!-- ===== 开发环境可读格式 ===== -->
    <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ===== 滚动文件输出（JSON格式，供日志采集平台接入） ===== -->
    <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 每天滚动，保留 30 天 -->
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>{"ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS}","level":"%level","app":"${appName}","thread":"%thread","logger":"%logger{36}","msg":"%replace(%msg){'\"', '\\"'}","ex":"%ex{short}"}%n</pattern>
        </encoder>
    </appender>

    <!-- ===== 环境分组配置 ===== -->
    <!-- 开发环境：可读格式，DEBUG 级别 -->
    <springProfile name="dev | !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_PLAIN"/>
        </root>
        <logger name="com.agent" level="DEBUG"/>
        <logger name="org.springframework.ai" level="INFO"/>
        <logger name="org.springframework.security" level="INFO"/>
    </springProfile>

    <!-- 生产环境：JSON 格式 + 文件滚动，INFO 级别 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE_JSON"/>
        </root>
        <logger name="com.agent" level="INFO"/>
        <!-- SQL 日志关闭 -->
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.springframework.ai" level="WARN"/>
    </springProfile>

</configuration>
